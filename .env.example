# Vesta Backup local development
# Copy this file to .env and supply your local settings.
# For packaged installations, use the Vesta site manifest.

# Use the real database account, host and password for your local development database.
DATABASE_URL=postgresql://vesta_runtime:@localhost:5432/vesta

# JWT Configuration
# Generate a private value with openssl rand -base64 32.
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24

# Optional separate read-only S3 account for bucket recovery.
S3_RECOVERY_ACCESS_KEY=
S3_RECOVERY_SECRET_KEY=

# Agent Authentication
# Generate a private value with openssl rand -hex 32 when using a local agent.
AGENT_API_KEY=

# Redis Configuration (for rate limiting and caching)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_STORAGE=redis://localhost:6379

# CORS — read via Settings.allowed_origins_list by middleware.py
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Application Settings
ENVIRONMENT=development
DEBUG=false
