{
  "apiVersion": "v1",
  "kind": "Service",
  "metadata": {
    "name": "vesta-frontend",
    "namespace": "vesta",
    "labels": {
      "app.kubernetes.io/part-of": "vesta"
    }
  },
  "spec": {
    "selector": {
      "app": "vesta-frontend"
    },
    "ports": [
      {
        "name": "http",
        "port": 8080,
        "targetPort": 8080
      }
    ]
  }
}
