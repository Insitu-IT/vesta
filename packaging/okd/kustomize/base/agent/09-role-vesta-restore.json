{
  "apiVersion": "rbac.authorization.k8s.io/v1",
  "kind": "Role",
  "metadata": {
    "name": "vesta-restore",
    "namespace": "protected-vms",
    "labels": {
      "app.kubernetes.io/part-of": "vesta"
    }
  },
  "rules": [
    {
      "apiGroups": [
        "kubevirt.io"
      ],
      "resources": [
        "virtualmachines"
      ],
      "verbs": [
        "get",
        "create"
      ]
    },
    {
      "apiGroups": [
        ""
      ],
      "resources": [
        "persistentvolumeclaims"
      ],
      "verbs": [
        "get",
        "create"
      ]
    },
    {
      "apiGroups": [
        ""
      ],
      "resources": [
        "secrets"
      ],
      "verbs": [
        "get",
        "create",
        "delete"
      ]
    },
    {
      "apiGroups": [
        ""
      ],
      "resources": [
        "configmaps"
      ],
      "verbs": [
        "get"
      ]
    },
    {
      "apiGroups": [
        ""
      ],
      "resources": [
        "pods"
      ],
      "verbs": [
        "get",
        "list"
      ]
    },
    {
      "apiGroups": [
        "batch"
      ],
      "resources": [
        "jobs"
      ],
      "verbs": [
        "get",
        "create"
      ]
    },
    {
      "apiGroups": [
        "k8s.cni.cncf.io"
      ],
      "resources": [
        "network-attachment-definitions"
      ],
      "verbs": [
        "get"
      ]
    }
  ]
}
