{
  "apiVersion": "v1",
  "kind": "PersistentVolumeClaim",
  "metadata": {
    "name": "vesta-scratch",
    "namespace": "protected-vms",
    "labels": {
      "app.kubernetes.io/part-of": "vesta"
    }
  },
  "spec": {
    "storageClassName": "example-scratch",
    "volumeMode": "Filesystem",
    "accessModes": [
      "ReadWriteMany"
    ],
    "resources": {
      "requests": {
        "storage": "64Gi"
      }
    }
  }
}
