{
  "apiVersion": "v1",
  "kind": "PersistentVolumeClaim",
  "metadata": {
    "name": "vesta-journal",
    "namespace": "vesta-agent",
    "labels": {
      "app.kubernetes.io/part-of": "vesta"
    }
  },
  "spec": {
    "storageClassName": "example-journal",
    "volumeMode": "Filesystem",
    "accessModes": [
      "ReadWriteOnce"
    ],
    "resources": {
      "requests": {
        "storage": "1Gi"
      }
    }
  }
}
