  "kind": "Service",
  "metadata": {
    "name": "vesta-agent",
    "namespace": "vesta-agent",
    "labels": {
      "app.kubernetes.io/part-of": "vesta"
    }
  },
  "spec": {
    "selector": {
      "app": "vesta-agent"
    },
    "ports": [
