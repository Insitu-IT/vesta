{
  "protocol": "vnbui-storage-transaction/1",
  "cases": [
    {
      "id": "F01",
      "inject": "plan commit fails",
      "expected_state": "not_dispatched",
      "production_test_id": "test_f01_plan_commit_failure",
      "production_test_status": "required_not_claimed_implemented",
      "invariants": [
        "no_agent_request",
        "no_s3_write",
        "no_native_backup"
      ]
    },
    {
      "id": "F02",
      "inject": "replacement VM/PVC or changed disk selection",
      "expected_state": "source_conflict",
      "production_test_id": "test_f02_source_replacement",
      "production_test_status": "required_not_claimed_implemented",
      "invariants": [
        "original_history_unchanged",
        "no_partial_backup"
      ]
    },
    {
      "id": "F03",
      "inject": "missing/extra artifact or oversize manifest",
      "expected_state": "cleanup_required",
      "production_test_id": "test_f03_receipt_set_and_bounds",
      "production_test_status": "required_not_claimed_implemented",
      "invariants": [
        "receipt_not_accepted",
        "reservation_retained"
      ]
    },
    {
      "id": "F04",
      "inject": "multipart creation/part/completion reply lost",
      "expected_state": "prepared_or_cleanup_required",
      "production_test_id": "test_f04_multipart_crash_boundaries",
      "production_test_status": "required_not_claimed_implemented",
      "invariants": [
        "exact_key_retained",
        "unknown_upload_id_holds",
        "no_guessed_reupload"
      ]
    },
    {
      "id": "F05",
      "inject": "acceptance reply lost, identical/conflicting retry",
      "expected_state": "receipt_accepted",
      "production_test_id": "test_f05_acceptance_replay",
      "production_test_status": "required_not_claimed_implemented",
      "invariants": [
        "identical_replay",
        "conflict_rejected",
        "no_checkpoint_inference"
      ]
    },
    {
      "id": "F06",
      "inject": "absent or same-transaction receipt plus publication",
      "expected_state": "reserved",
      "production_test_id": "test_f06_prior_transaction_required",
      "production_test_status": "required_not_claimed_implemented",
      "invariants": [
        "db_and_api_refuse",
        "no_visible_member"
      ]
    },
