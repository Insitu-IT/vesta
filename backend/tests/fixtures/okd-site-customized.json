        "cpu": "2",
        "memory": "2Gi"
      }
    },
    "migration": {
      "requests": {
        "cpu": "250m",
        "memory": "256Mi"
      },
      "limits": {
        "cpu": "1",
        "memory": "1Gi"
      }
    }
  },
  "agent_namespace": "vnbui-agent",
  "source_namespaces": [
    "protected-vms"
