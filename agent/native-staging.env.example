# Optional profile. Not activated by package installation or update.
# Find the service account and group with `systemctl show vesta-agent -p User -p Group`.
# Enter their numeric IDs from `id -u USER` and `getent group GROUP` (third field).
NATIVE_STAGING_UID=REPLACE_WITH_AGENT_UID
NATIVE_STAGING_GID=REPLACE_WITH_AGENT_GID
# Example budgets only; size the dedicated filesystem for actual protected data.
# Reservations are admission accounting, not an OS quota.
NATIVE_STAGING_RESERVED_BYTES=1073741824
NATIVE_STAGING_CAPACITY_BYTES=8589934592
NATIVE_STAGING_MINIMUM_FREE_BYTES=536870912
# Separately enroll an EMPTY agent journal using these in agent.env:
# NATIVE_STAGING_ROOT=/var/lib/vesta-native-staging/attempts
# NATIVE_STAGING_SOCKET=/run/vesta-native-staging/broker.sock
# Never redirect a populated journal or move its old native attempt directories.
