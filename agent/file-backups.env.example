ENVIRONMENT=production
ORCHESTRATOR_URL=https://vesta.example.org
ORCHESTRATOR_API_KEY=replace-with-orchestrator-key
REGISTRATION_KEY=replace-with-scoped-registration-key
TLS_ENABLED=true
TLS_VERIFY_CLIENT=true

# Set the trusted orchestrator CA when it is absent from the system trust store.
# TLS_CA_FILE=/etc/vesta/certs/orchestrator-ca.crt

# Fresh enrollment stores a callback identity under /var/lib/vesta/certs.
CALLBACK_CLIENT_CERT_FILE=/var/lib/vesta/certs/agent.crt
CALLBACK_CLIENT_KEY_FILE=/var/lib/vesta/certs/agent.key

# Optional site-managed agent server certificate and backend client CA.
# TLS_CERT_FILE=/etc/vesta/certs/agent.crt
# TLS_KEY_FILE=/etc/vesta/certs/agent.key
# TLS_CLIENT_CA_FILE=/etc/vesta/certs/backend-client-ca.crt

VESTA_WORKLOADS=files
VESTA_FILE_BACKUP_CONFIG=/etc/vesta/file-backups.json
# VESTA_FILE_BACKUP_STATE=/var/lib/vesta/file-backups
