# Vesta Agent Configuration
# Supported native libvirt push-agent configuration template
# Copy to /etc/vesta/agent.env and customize for your environment

# ==============================================================================
# REQUIRED SETTINGS
# ==============================================================================

# Orchestrator Connection
# URL of the Vesta backend (orchestrator)
# API is accessed via the main URL (frontend proxies /api/* to backend)
# The native transaction path requires verified HTTPS. No HTTP fallback.
ORCHESTRATOR_URL=https://vesta.example.org

# Orchestrator API Key (orchestrator → agent authentication)
# This is a shared secret that validates requests FROM the orchestrator TO this agent
# CRITICAL: Must match the ORCHESTRATOR_API_KEY in the orchestrator's configuration
ORCHESTRATOR_API_KEY=your-orchestrator-api-key-here

# Initial Registration Key (one-time use, remove after registration)
# Used only for the first registration with the orchestrator
# Issue a scoped registration key in the Vesta backend.
# After successful registration, you can remove this line for security
REGISTRATION_KEY=your-one-time-registration-key-here

# Backup Storage Path
# Where backup files will be stored on this KVM host
# Must have sufficient disk space (hundreds of GB recommended)
# Ensure vesta-agent user has write permissions
BACKUP_STORAGE_PATH=/var/lib/vesta/backups

# Libvirt Connection URI
# Connection string for libvirt on this host
# Standard: qemu:///system (local system connection)
# The supported native producer operates locally; remote libvirt URIs are not
# part of this installation profile.
LIBVIRT_URI=qemu:///system

# ==============================================================================
# AGENT CREDENTIALS (Set automatically after registration)
# ==============================================================================

# These are set automatically after successful registration with orchestrator
# DO NOT set manually - they will be saved securely in /var/lib/vesta/agent.key

# AGENT_ID=<auto-set-after-registration>
# AGENT_API_KEY=<auto-set-after-registration>

# ==============================================================================
# OPTIONAL SETTINGS (Recommended defaults)
# ==============================================================================

# === Agent Identity ===
# Hostname (defaults to system hostname)
# HOSTNAME=kvm-host-1

# Agent API port
AGENT_PORT=8090

# Agent bind address (0.0.0.0 = all interfaces)
AGENT_HOST=0.0.0.0

# Environment (development, staging, production)
ENVIRONMENT=production

# === Backup Execution ===
# Native libvirt push uses durable private attempt files, not virtnbdbackup.

# Maximum concurrent backup operations
# Recommendation: 1-2 for production (avoid overloading host)
MAX_CONCURRENT_BACKUPS=2

# Backup operation timeout (seconds)
# 7200 = 2 hours (adjust based on VM sizes)
BACKUP_TIMEOUT=7200

# === Libvirt ===
# Libvirt connection timeout (seconds)
LIBVIRT_CONNECTION_TIMEOUT=30

# Libvirt retry attempts on connection failure
LIBVIRT_RETRY_ATTEMPTS=3

# === Monitoring ===
# Enable heartbeat to orchestrator
HEARTBEAT_ENABLED=true

# Heartbeat interval (seconds)
# Recommendation: 30-60 seconds
HEARTBEAT_INTERVAL=30

# Enable performance monitoring
ENABLE_PERFORMANCE_MONITORING=true

# Metrics collection interval (seconds)
METRICS_COLLECTION_INTERVAL=5

# Prometheus metrics port
METRICS_PORT=9090

# === Logging ===
# Log level: DEBUG, INFO, WARNING, ERROR
# Production: INFO or WARNING
# Development/troubleshooting: DEBUG
LOG_LEVEL=INFO

# Log format: json (production) or text (development)
# json = structured logs for aggregation
# text = human-readable for local debugging
LOG_FORMAT=json

# Log file path (optional, can log to stdout only)
LOG_FILE=/var/log/vesta/agent.log

# === Security ===
# Enable API key validation (NEVER disable in production!)
ENABLE_API_KEY_VALIDATION=true

# Require TLS for orchestrator connection
REQUIRE_TLS=true

# Allowed orchestrator IPs (comma-separated, optional)
# If set, only these IPs can connect to agent
# Leave empty to allow from any IP
# ALLOWED_ORCHESTRATOR_IPS=10.0.1.10,10.0.1.11

# === TLS/CA Configuration ===
# Custom CA certificate path (optional)
# Use if orchestrator uses self-signed certificate or internal CA
# If not set, uses system CA bundle (certifi)
# ORCHESTRATOR_CA_CERT=/etc/vesta/ca.crt

# Verify the backend certificate; install its CA in the service trust store.
ORCHESTRATOR_VERIFY_SSL=true

# The agent listener also requires HTTPS and verified client certificates.
# Install site-issued files readable by the vesta-agent service before starting it.
TLS_ENABLED=true
TLS_CERT_FILE=/etc/vesta/certs/agent.crt
TLS_KEY_FILE=/etc/vesta/certs/agent.key
TLS_CA_FILE=/etc/vesta/certs/ca.crt
TLS_VERIFY_CLIENT=true

# === Key Storage ===
# Path to secure key storage file
# Agent credentials encrypted and stored here
# Must be writable by vesta-agent user
KEY_FILE_PATH=/var/lib/vesta/agent.key

# === Registration ===
# Registration retry interval if initial registration fails (seconds)
REGISTRATION_RETRY_INTERVAL=60

# ==============================================================================
# DEVELOPMENT/TESTING ONLY - NEVER USE IN PRODUCTION
# ==============================================================================

# Mock libvirt (no real KVM connection needed)
# MOCK_LIBVIRT=false


# ==============================================================================
# NOTES
# ==============================================================================

# After Installation:
# 1. Copy this template: sudo cp /etc/vesta/agent.env.example /etc/vesta/agent.env
# 2. Edit with your values: sudo nano /etc/vesta/agent.env
# 3. Get orchestrator keys from Vesta backend secrets
# 4. Set ORCHESTRATOR_URL to your Vesta API endpoint
# 5. Ensure BACKUP_STORAGE_PATH exists and has space
# 6. Start agent: sudo systemctl start vesta-agent
# 7. Verify systemctl status and authenticated HTTPS health from the backend.
# 8. After successful registration, remove REGISTRATION_KEY line

# Verification:
# - Agent registered: Check orchestrator UI for this agent
# - Heartbeat working: journalctl -u vesta-agent | grep heartbeat
# - Backups working: Trigger test backup from orchestrator
# - Metrics available only through the site's approved authenticated path.

# Security Best Practices:
# - File permissions: sudo chmod 600 /etc/vesta/agent.env
# - Owner: sudo chown root:root /etc/vesta/agent.env
# - Never commit this file to version control (contains secrets)
# - Rotate ORCHESTRATOR_API_KEY periodically (every 90 days)
# - Monitor agent.log for authentication failures

# Troubleshooting:
# - Agent won't start: Check ORCHESTRATOR_URL is reachable
# - Won't register: Check REGISTRATION_KEY matches orchestrator
# - 401/403 errors: Check ORCHESTRATOR_API_KEY matches orchestrator
# - Heartbeat failing: Check AGENT_API_KEY is set (auto-set after registration)
# - Backups failing: Check BACKUP_STORAGE_PATH has space and permissions
