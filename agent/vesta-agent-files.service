[Unit]
Description=Vesta Linux File Backup Agent
Documentation=https://github.com/Insitu-IT/vesta
After=network.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=vesta-agent
Group=vesta-agent
UMask=0027
WorkingDirectory=/opt/vesta-agent
Environment=KEY_FILE_PATH=/var/lib/vesta/agent.key
Environment=VESTA_WORKLOADS=files
Environment=TLS_JOURNAL_DIR=/var/lib/vesta/certs
EnvironmentFile=/etc/vesta/agent.env
NoNewPrivileges=true
CapabilityBoundingSet=
PrivateTmp=true
ProtectHome=read-only
ProtectSystem=strict
ReadWritePaths=/var/lib/vesta
MemoryMax=512M
CPUQuota=50%
TasksMax=100
ExecStart=/opt/vesta-agent/vesta-agent
Restart=on-failure
RestartSec=30
StandardOutput=journal
StandardError=journal
SyslogIdentifier=vesta-agent

[Install]
WantedBy=multi-user.target
